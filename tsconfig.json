{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "allowJs": true,
        "lib": ["es2022", "dom"],
        "module": "es2022",
        "target": "es2020",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["jest", "node"],
        "declaration": true,
        "rootDir": "src",
        "outDir": "dist"
    },
    "include": ["src/**/*"]
}